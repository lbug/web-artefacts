{
  "name": "web-artefacts",
  "version": "0.1.0",
  "description": "Local artifact viewer for coding agents: publish HTML via MCP, view and comment in a sandboxed browser viewer",
  "keywords": [
    "mcp",
    "artifacts",
    "opencode",
    "claude-code",
    "agent",
    "html",
    "viewer"
  ],
  "homepage": "https://github.com/lbug/web-artefacts#readme",
  "bugs": {
    "url": "https://github.com/lbug/web-artefacts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbug/web-artefacts.git"
  },
  "license": "MIT",
  "author": "lbug",
  "type": "module",
  "bin": {
    "web-artefacts": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "migrations"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch src/cli.ts serve",
    "start": "node src/cli.ts serve",
    "mcp": "node src/cli.ts mcp",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "zod": "^4.6.5",
    "@modelcontextprotocol/server": "^2.1.0",
    "@modelcontextprotocol/client": "^2.1.0"
  },
  "private": true
}
